/* ============================================================================
 * OmniPresence v2.3.0 — Obsidian Glassmorphism & Micro-Glow Specification
 * Palette Hierarchy:
 *   Base Canvas    : #0D1117
 *   Surface Card   : rgba(22, 27, 34, 0.70)
 *   Glass Panel    : rgba(26, 33, 44, 0.65)
 *   Primary Accent : Cyan (#00E5FF) -> Purple (#A855F7)
 *   Emerald Active : #10B981
 *   High-Contrast  : #F8FAFC
 *   Glass Border   : 1px solid rgba(255, 255, 255, 0.08)
 * ============================================================================ */

QMainWindow, QWidget#centralWidget, QWidget#mainContainer, QWidget#WindowCanvas, QWidget#SettingsScrollContent {
    background-color: #0D1117;
    color: #E6EDF3;
    font-family: "Inter", "Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI";
    font-size: 13px;
}

QScrollArea#SettingsScrollArea,
QScrollArea#SettingsScroll {
    background-color: #0D1117;
    border: none;
}

QFrame#WindowShell {
    background-color: #0D1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

/* --- Custom Titlebar & Telemetry Header --- */

QFrame#TitleBar {
    background-color: rgba(22, 27, 34, 0.58);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}

QLabel#TitleBrand {
    color: #F8FAFC;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QLabel#TitleVersionBadge,
QLabel#CardPillBadge,
QLabel#GatewayBadge {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 2px 8px;
    color: #79C0FF;
    font-size: 11px;
}

QLabel#GatewayBadge[official="true"] {
    background-color: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34D399;
}

QFrame#StatusPill {
    background-color: rgba(22, 27, 34, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2px 10px;
}

QLabel#StatusText {
    color: #E2E8F0;
}

QFrame#TelemetryCluster {
    background-color: rgba(22, 27, 34, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

QPushButton#TitleButton,
QPushButton#TitleCloseButton {
    background-color: transparent;
    color: #94A3B8;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
}

QPushButton#TitleButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(0, 229, 255, 0.40);
}

QPushButton#TitleCloseButton:hover {
    background-color: rgba(239, 68, 68, 0.22);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.45);
}

/* --- Left Navigation Sidebar (220px <-> 68px Obsidian Glass) --- */

QFrame#Sidebar,
QFrame#sidebar {
    background-color: #0B0E14;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom-left-radius: 13px;
}

QPushButton#SidebarCollapseButton {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #C9D1D9;
    padding: 2px 6px;
}

QPushButton#SidebarCollapseButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 229, 255, 0.4);
    color: #FFFFFF;
}

QPushButton#SidebarNavButton {
    background-color: transparent;
    color: #94A3B8;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 10px;
    padding: 9px 14px;
    text-align: left;
    font-weight: 600;
}

QPushButton#SidebarNavButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(0, 229, 255, 0.25);
    color: #FFFFFF;
}

QPushButton#SidebarNavButton[active="true"] {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 229, 255, 0.22),
        stop:1 rgba(168, 85, 247, 0.16)
    );
    color: #FFFFFF;
    border: 1px solid rgba(0, 229, 255, 0.38);
    border-left: 3px solid #00E5FF;
    font-weight: 700;
}

QPushButton#SidebarNavButton[collapsed="true"] {
    padding: 9px 4px;
    text-align: center;
}

QFrame#SidebarFooter {
    background-color: #161B22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

/* --- Containers / Panels (Obsidian Glass Spec) --- */

QFrame#card,
QFrame.glass-panel,
QGroupBox,
QFrame#PanelCard,
QFrame#QuickControlsBar,
QFrame#LogPanel,
QFrame#SettingsCard,
QFrame#HudCard {
    background-color: #161B22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

QFrame#SettingsCard[active="true"] {
    border: 1px solid rgba(0, 229, 255, 0.26);
}

QFrame#CardDivider {
    background-color: rgba(255, 255, 255, 0.07);
    border: none;
}

QLabel#SectionHeading,
QLabel#CardTitle {
    color: #F8FAFC;
    font-weight: 700;
}

QLabel#SettingRowLabel {
    color: #E2E8F0;
    font-weight: 600;
}

QLabel#SectionCaption {
    color: #94A3B8;
}

QLabel#RuleErrorBanner {
    background-color: rgba(239, 68, 68, 0.14);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.40);
    border-radius: 8px;
    padding: 6px 10px;
}

/* --- Live Discord Profile Card Mockup (Floating Glass Media Widget) --- */

QFrame#DiscordCard {
    background-color: rgba(22, 27, 34, 0.70);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
}

QFrame#DiscordBox {
    background-color: rgba(26, 33, 44, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

QLabel#DcName {
    color: #F8FAFC;
    font-weight: 700;
}

QLabel#DcHandle {
    color: #94A3B8;
}

QLabel#DcBadgePill {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 2px 8px;
    color: #79C0FF;
    font-size: 11px;
}

QLabel#DcSection {
    color: #CBD5E1;
    letter-spacing: 0.4px;
}

QLabel#DcDetails {
    color: #F8FAFC;
    font-weight: 600;
}

QLabel#DcState,
QLabel#DcClock {
    color: #94A3B8;
}

QLabel#DcEmpty {
    color: #64748B;
}

QPushButton#DiscordButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton#DiscordButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-color: rgba(0, 229, 255, 0.45);
    color: #FFFFFF;
}

QLabel#PreviewNote {
    color: #94A3B8;
}

QLabel#PreviewReason {
    background-color: rgba(13, 17, 23, 0.75);
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 5px 8px;
}

/* --- Inputs & Action Buttons (Obsidian Glass & Micro-Glow) --- */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #0D1117;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 24px;
    selection-background-color: rgba(0, 229, 255, 0.35);
}

QLineEdit:disabled {
    background-color: rgba(13, 17, 23, 0.45);
    color: #64748B;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: rgba(26, 33, 44, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: #0E131B;
    border: 1px solid #00E5FF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161B22;
    color: #F8FAFC;
    border: 1px solid rgba(0, 229, 255, 0.35);
    selection-background-color: rgba(0, 229, 255, 0.25);
    selection-color: #F8FAFC;
}

QFrame#SubCardFrame {
    background-color: rgba(13, 17, 23, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}

QRadioButton {
    color: #F8FAFC;
    spacing: 7px;
}

QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background-color: #0D1117;
}

QRadioButton::indicator:hover {
    border: 1px solid #00E5FF;
}

QRadioButton::indicator:checked {
    background-color: #00E5FF;
    border: 3px solid #161B22;
}

/* Secondary Buttons & Action Pills */
QPushButton {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #C9D1D9;
    padding: 6px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 229, 255, 0.4);
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: rgba(0, 229, 255, 0.14);
    border: 1px solid #00E5FF;
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    color: #475569;
}

QPushButton#ModePill {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #C9D1D9;
    padding: 5px 11px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#ModePill:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 229, 255, 0.4);
    color: #FFFFFF;
}

QPushButton#ModePill[active="true"] {
    background-color: rgba(0, 229, 255, 0.16);
    border: 1px solid rgba(0, 229, 255, 0.50);
    color: #79C0FF;
}

/* Accent Primary Buttons (Engage Override, Apply & Reconnect) */
QPushButton#PrimaryButton {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #00E5FF,
        stop:1 #A855F7
    );
    color: #0D1117;
    font-weight: 700;
    border-radius: 10px;
    border: none;
    padding: 8px 16px;
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #33EBFF,
        stop:1 #B975F9
    );
    color: #0D1117;
}

QPushButton#PrimaryButton:disabled {
    background: rgba(255, 255, 255, 0.05);
    color: #64748B;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#PrimaryButton[active="true"] {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #EF4444,
        stop:1 #F97316
    );
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#ToggleButton[active="true"] {
    background-color: rgba(245, 158, 11, 0.22);
    color: #FEF3C7;
    border: 1px solid rgba(245, 158, 11, 0.58);
}

/* --- Context Detection Rules Table --- */

QTableWidget#RuleTable {
    background-color: #0D1117;
    alternate-background-color: rgba(22, 27, 34, 0.70);
    color: #F8FAFC;
    gridline-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    selection-background-color: rgba(0, 229, 255, 0.20);
    selection-color: #F8FAFC;
    outline: none;
}

QTableWidget#RuleTable::item {
    padding: 6px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget#RuleTable::item:hover {
    background-color: rgba(26, 33, 44, 0.85);
}

QTableWidget#RuleTable::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background-color: #161B22;
}

QTableWidget#RuleTable::indicator:checked {
    background-color: #00E5FF;
    border: 1px solid #79C0FF;
}

QHeaderView::section {
    background-color: rgba(22, 27, 34, 0.85);
    color: #94A3B8;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px;
    font-weight: 600;
}

/* --- Modern Log Console & Slim Scrollbars --- */

QTextEdit#ActivityLogView,
QPlainTextEdit#ActivityLogView {
    background-color: rgba(13, 17, 23, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    color: #8B949E;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    padding: 6px 10px;
    selection-background-color: rgba(0, 229, 255, 0.35);
}

QTextEdit#ActivityLogView:focus,
QPlainTextEdit#ActivityLogView:focus {
    border: 1px solid rgba(0, 229, 255, 0.45);
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.25);
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 229, 255, 0.55);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0px;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.25);
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QToolTip {
    background-color: #161B22;
    color: #F8FAFC;
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 6px;
    padding: 5px 8px;
}

/* --- GitHub Releases Auto-Update Notification Banner --- */

QFrame#UpdateBanner {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 229, 255, 0.14),
        stop:1 rgba(168, 85, 247, 0.14)
    );
    border-bottom: 1px solid rgba(0, 229, 255, 0.35);
}

QLabel#UpdateBannerText {
    color: #F8FAFC;
    background: transparent;
}

QProgressBar#UpdateProgressBar {
    background-color: rgba(13, 17, 23, 0.75);
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 6px;
    text-align: center;
    color: #F8FAFC;
    font-size: 10px;
}

QProgressBar#UpdateProgressBar::chunk {
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #00E5FF,
        stop:1 #A855F7
    );
    border-radius: 5px;
}
